@model IEnumerable<Kutuphane.Models.Kitap>
@{
    ViewData["Title"] = "Kitaplar";
    var pasifKitaplar = ViewBag.PasifKitaplar as List<Kutuphane.Models.Kitap>;
}

<h1 class="mb-4"><i class="fas fa-book"></i> Kitaplar</h1>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <b>Aktif Kitaplar</b>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Adı</th>
                        <th>Yazar</th>
                        <th>Yayınevi</th>
                        <th>ISBN</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.KitapAdi</td>
                            <td>@item.Yazar</td>
                            <td>@item.Yayinevi</td>
                            <td>@item.ISBN</td>
                            <td>@item.Kategori?.KategoriAdi ?? "-"</td>
                            <td>
                                @if (item.OduncVerildiMi)
                                {
                                    <span class="badge bg-danger">Ödünç Verildi</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Mevcut</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Guncelle" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Güncelle</a>
                                <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Ekle" class="btn btn-primary mb-4"><i class="fas fa-plus"></i> Yeni Kitap Ekle</a>

@if (pasifKitaplar != null && pasifKitaplar.Count > 0)
{
    <div class="card mt-4 border-danger">
        <div class="card-header bg-danger text-white">
            <b>Silinen (Pasif) Kitaplar</b>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Adı</th>
                            <th>Yazar</th>
                            <th>Yayınevi</th>
                            <th>ISBN</th>
                            <th>Kategori</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pasifKitaplar)
                        {
                            <tr class="table-danger">
                                <td>@item.KitapAdi</td>
                                <td>@item.Yazar</td>
                                <td>@item.Yayinevi</td>
                                <td>@item.ISBN</td>
                                <td>@item.Kategori?.KategoriAdi ?? "-"</td>
                                <td>
                                    <form asp-action="GeriAl" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-undo"></i> Geri Al</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
