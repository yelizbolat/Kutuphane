@model Kutuphane.Models.Kitap

@{
    ViewData["Title"] = "Kitap Sil";
}

<h1>❌ Kitap Sil</h1>

<div class="warning-box">
    <strong>Dikkat:</strong> Bu kitabı <u>kalıcı olarak silmek</u> üzeresiniz. Emin misiniz?
</div>

<dl>
    <dt>@Html.DisplayNameFor(model => model.KitapAdi)</dt>
    <dd>@Html.DisplayFor(model => model.KitapAdi)</dd>

    <dt>@Html.DisplayNameFor(model => model.Yazar)</dt>
    <dd>@Html.DisplayFor(model => model.Yazar)</dd>

    <dt>@Html.DisplayNameFor(model => model.Yayinevi)</dt>
    <dd>@Html.DisplayFor(model => model.Yayinevi)</dd>

    <dt>@Html.DisplayNameFor(model => model.Kategori)</dt>
    <dd>@(Model.Kategori?.KategoriAdi ?? "<em>Yok</em>")</dd>
</dl>

<form asp-action="Sil">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="❌ Kalıcı Olarak Sil" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">↩️ Listeye Dön</a>
</form>