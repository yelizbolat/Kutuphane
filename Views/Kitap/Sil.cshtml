@model Kutuphane.Models.Kitap

@{
    ViewData["Title"] = "Kitap Sil";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />

<style>
    body {
        background-color: #121212;
        color: #f5f5f5;
        font-family: 'Inter', sans-serif;
        padding: 40px;
    }

    h1 {
        color: #ff4d4f;
        font-weight: 600;
        margin-bottom: 20px;
        text-shadow: 0 0 6px rgba(255, 77, 79, 0.6);
    }

    .warning-box {
        background-color: #2b1a1a;
        padding: 16px 24px;
        border-left: 5px solid #ff4d4f;
        border-radius: 10px;
        margin-bottom: 30px;
        color: #ffb3b3;
    }

    dl {
        background-color: #1e1e2e;
        padding: 24px;
        border-radius: 10px;
        box-shadow: 0 0 8px rgba(255, 255, 255, 0.05);
        margin-bottom: 30px;
    }

    dt {
        color: #66ffe3;
        font-weight: 600;
        margin-top: 10px;
    }

    dd {
        margin-bottom: 10px;
        color: #ddd;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.95rem;
        border: none;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }

    .btn-danger {
        background-color: #ff4d4f;
        color: white;
        box-shadow: 0 0 10px rgba(255, 77, 79, 0.3);
    }

    .btn-danger:hover {
        background-color: #e60023;
    }

    .btn-secondary {
        background-color: #2e2e3e;
        color: white;
        margin-left: 12px;
    }

    .btn-secondary:hover {
        background-color: #444456;
    }

    form {
        margin-top: 10px;
    }
</style>

<h1>❌ Kitap Sil</h1>

<div class="warning-box">
    <strong>Dikkat:</strong> Bu kitabı <u>kalıcı olarak silmek</u> üzeresiniz. Emin misiniz?
</div>

<dl>
    <dt>@Html.DisplayNameFor(model => model.KitapAdi)</dt>
    <dd>@Html.DisplayFor(model => model.KitapAdi)</dd>

    <dt>@Html.DisplayNameFor(model => model.Yazar)</dt>
    <dd>@Html.DisplayFor(model => model.Yazar)</dd>

    <dt>@Html.DisplayNameFor(model => model.Yayinevi)</dt>
    <dd>@Html.DisplayFor(model => model.Yayinevi)</dd>

    <dt>@Html.DisplayNameFor(model => model.Kategori)</dt>
    <dd>@(Model.Kategori?.KategoriAdi ?? "<em>Yok</em>")</dd>
</dl>

<form asp-action="Sil">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="❌ Kalıcı Olarak Sil" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">↩️ Listeye Dön</a>
</form>