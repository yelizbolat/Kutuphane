@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "En Çok Okuyan Öğrenciler";
}

<h2 class="mb-4"><i class="fas fa-user-graduate"></i> En Çok Okuyan Öğrenciler</h2>
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Adı Soyadı</th>
                        <th>Okul Numarası</th>
                        <th>Okuduğu Kitap Sayısı</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int sira = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@sira</td>
                                <td>@item.Ogrenci?.OgrenciAdi @item.Ogrenci?.OgrenciSoyadi</td>
                                <td>@item.Ogrenci?.OkulNumarasi</td>
                                <td><span class="badge bg-success">@item.OkumaSayisi</span></td>
                            </tr>
                            sira++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 