@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "En Çok Okunan Kitaplar";
}

<h2 class="mb-4"><i class="fas fa-book"></i> En Çok Okunan Kitaplar</h2>
<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Kitap Adı</th>
                        <th>Yazar</th>
                        <th>Kategori</th>
                        <th>Okunma Sayısı</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int sira = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@sira</td>
                                <td>@item.Kitap?.KitapAdi</td>
                                <td>@item.Kitap?.Yazar</td>
                                <td>@item.Kitap?.Kategori?.KategoriAdi</td>
                                <td><span class="badge bg-success">@item.OkunmaSayisi</span></td>
                            </tr>
                            sira++;
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div> 