@model IEnumerable<Kutuphane.Models.OduncKitap>

@{
    ViewData["Title"] = "Ödünç Alınan Kitaplar Raporu";
}

<!-- Google Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #121524;
        color: #ddd;
        padding: 30px;
        cursor: none;
        margin: 0;
    }

    h2 {
        text-align: center;
        color: #4fc3f7;
        font-weight: 600;
        margin-bottom: 30px;
        text-shadow: 0 0 6px #4fc3f7;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(79, 195, 247, 0.2);
        background-color: #1e263b;
    }

    thead {
        background-color: #4fc3f7;
        color: #fff;
        font-weight: 600;
    }

    th, td {
        padding: 12px 16px;
        text-align: center;
        border-bottom: 1px solid #2a3350;
        font-size: 0.95rem;
    }

    tbody tr:hover {
        background-color: #36455c;
        cursor: default;
    }

    .btn-secondary {
        display: inline-block;
        margin-top: 25px;
        padding: 10px 28px;
        font-weight: 600;
        border-radius: 25px;
        background-color: #374a6d;
        color: #ddd;
        text-decoration: none;
        box-shadow: 0 2px 8px rgba(79, 195, 247, 0.3);
        transition: background-color 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #4fc3f7;
        color: #121524;
    }

    /* Custom cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 30px;
        height: 30px;
        border: 2px solid #4fc3f7;
        border-radius: 50%;
        pointer-events: none;
        transform: translate(-50%, -50%);
        transition: transform 0.15s ease, background-color 0.3s ease;
        z-index: 9999;
        mix-blend-mode: difference;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.5);
        background-color: #4fc3f7;
        border-color: white;
    }
</style>

<h2>📚 Ödünç Alınan Kitaplar</h2>

<table>
    <thead>
        <tr>
            <th>Öğrenci</th>
            <th>Kitap</th>
            <th>Alış Tarihi</th>
            <th>İade Tarihi</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Ogrenci != null ? item.Ogrenci.OgrenciAdi : "Silinmiş Öğrenci")</td>
                <td>@(item.Kitap?.KitapAdi ?? "Silinmiş Kitap")</td>
                <td>@item.OduncAlmaTarihi.ToString("dd.MM.yyyy")</td>
                <td>@(item.TeslimTarihi.HasValue ? item.TeslimTarihi.Value.ToString("dd.MM.yyyy") : "Henüz İade Edilmedi")</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center">
    <a asp-controller="Home" asp-action="Index" class="btn-secondary">🏠 Ana Sayfa</a>
</div>

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
