@model Kutuphane.Models.OduncKitap

@{
    ViewData["Title"] = "Kitap Ödünç Ver";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-book-reader me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    <form id="oduncForm">
                        @Html.AntiForgeryToken()
                        <div id="alertArea"></div>

                        <!-- Kitap Arama -->
                        <div class="mb-4">
                            <label for="kitapArama" class="form-label">Kitap Ara</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-book"></i>
                                </span>
                                <input type="text" id="kitapArama" class="form-control" placeholder="Kitap adı veya yazar adı yazın..." autocomplete="off" />
                            </div>
                            <div id="kitapSonuclari" class="list-group mt-2" style="display:none;"></div>
                            <div id="seciliKitap" class="alert alert-success mt-2" style="display:none;">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <div>
                                        <strong>Seçili Kitap:</strong>
                                        <span id="seciliKitapAdi"></span>
                                    </div>
                                </div>
                                <input type="hidden" id="kitapId" />
                            </div>
                        </div>

                        <!-- Öğrenci Arama -->
                        <div class="mb-4">
                            <label for="ogrenciArama" class="form-label">Öğrenci Ara</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="fas fa-user-graduate"></i>
                                </span>
                                <input type="text" id="ogrenciArama" class="form-control" placeholder="Öğrenci adı veya okul numarası yazın..." autocomplete="off" />
                            </div>
                            <div id="ogrenciSonuclari" class="list-group mt-2" style="display:none;"></div>
                            <div id="seciliOgrenci" class="alert alert-success mt-2" style="display:none;">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-check-circle me-2"></i>
                                    <div>
                                        <strong>Seçili Öğrenci:</strong>
                                        <span id="seciliOgrenciAdi"></span>
                                    </div>
                                </div>
                                <input type="hidden" id="ogrenciId" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary" id="tamamlaBtn" disabled>
                                <i class="fas fa-check me-2"></i>Tamamla
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Kitap arama
            $('#kitapArama').on('input', function () {
                var arama = $(this).val().trim();
                if (arama.length >= 2) {
                    $.get('/Odunc/KitapAra', { arama: arama }, function (kitaplar) {
                        var sonuclar = $('#kitapSonuclari');
                        sonuclar.empty().show();
                        if (kitaplar && kitaplar.length > 0) {
                            kitaplar.forEach(function (kitap) {
                                sonuclar.append(`
                                    <div class="list-group-item list-group-item-action d-flex align-items-center p-3" 
                                         data-id="${kitap.id}" 
                                         data-ad="${kitap.ad}">
                                        <i class="fas fa-book me-3 text-primary"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">${kitap.ad}</h6>
                                            <small class="text-muted">Kitap</small>
                                        </div>
                                        <i class="fas fa-chevron-right text-muted"></i>
                                    </div>
                                `);
                            });
                        } else {
                            sonuclar.append(`
                                <div class="list-group-item text-center p-3">
                                    <i class="fas fa-search me-2"></i>
                                    Sonuç bulunamadı
                                </div>
                            `);
                        }
                    });
                } else {
                    $('#kitapSonuclari').hide();
                }
            });

            // Öğrenci arama
            $('#ogrenciArama').on('input', function () {
                var arama = $(this).val().trim();
                if (arama.length >= 2) {
                    $.get('/Odunc/OgrenciAra', { arama: arama }, function (ogrenciler) {
                        var sonuclar = $('#ogrenciSonuclari');
                        sonuclar.empty().show();
                        if (ogrenciler && ogrenciler.length > 0) {
                            ogrenciler.forEach(function (ogrenci) {
                                sonuclar.append(`
                                    <div class="list-group-item list-group-item-action d-flex align-items-center p-3" 
                                         data-id="${ogrenci.id}" 
                                         data-ad="${ogrenci.adSoyad}">
                                        <i class="fas fa-user-graduate me-3 text-primary"></i>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">${ogrenci.adSoyad}</h6>
                                            <small class="text-muted">Öğrenci</small>
                                        </div>
                                        <i class="fas fa-chevron-right text-muted"></i>
                                    </div>
                                `);
                            });
                        } else {
                            sonuclar.append(`
                                <div class="list-group-item text-center p-3">
                                    <i class="fas fa-search me-2"></i>
                                    Sonuç bulunamadı
                                </div>
                            `);
                        }
                    });
                } else {
                    $('#ogrenciSonuclari').hide();
                }
            });

            // Kitap seçimi
            $('#kitapSonuclari').on('click', '.list-group-item:not(.disabled)', function () {
                var id = $(this).data('id');
                var ad = $(this).data('ad');
                $('#kitapId').val(id);
                $('#seciliKitapAdi').text(ad);
                $('#seciliKitap').show();
                $('#kitapSonuclari').hide();
                $('#kitapArama').val('');
                kontrolEt();
            });

            // Öğrenci seçimi
            $('#ogrenciSonuclari').on('click', '.list-group-item', function () {
                var id = $(this).data('id');
                var ad = $(this).data('ad');
                $('#ogrenciId').val(id);
                $('#seciliOgrenciAdi').text(ad);
                $('#seciliOgrenci').show();
                $('#ogrenciSonuclari').hide();
                $('#ogrenciArama').val('');
                kontrolEt();
            });

            // Form kontrolü
            function kontrolEt() {
                const kitapSecildi = $('#kitapId').val() !== '';
                const ogrenciSecildi = $('#ogrenciId').val() !== '';
                $('#tamamlaBtn').prop('disabled', !(kitapSecildi && ogrenciSecildi));
            }

            // Form gönderimi
            $('#tamamlaBtn').click(function () {
                const formData = {
                    KitapId: $('#kitapId').val(),
                    OgrenciId: $('#ogrenciId').val()
                };

                $.ajax({
                    url: '/Odunc/Ver',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            $('#alertArea').html(`
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fas fa-check-circle me-2"></i>${response.message}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `);
                            // Formu temizle
                            $('#seciliKitap, #seciliOgrenci').hide();
                            $('#kitapId, #ogrenciId').val('');
                            $('#tamamlaBtn').prop('disabled', true);
                            
                            // 2 saniye sonra listeye yönlendir
                            setTimeout(function() {
                                window.location.href = '/Odunc/Index';
                            }, 2000);
                        } else {
                            $('#alertArea').html(`
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <i class="fas fa-exclamation-circle me-2"></i>${response.message}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            `);
                        }
                    },
                    error: function () {
                        $('#alertArea').html(`
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>İşlem sırasında bir hata oluştu.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        `);
                    }
                });
            });
        });
    </script>
}
