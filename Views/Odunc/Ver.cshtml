@model Kutuphane.Models.OduncKitap

@{
    ViewData["Title"] = "Kitap Ödünç Ver";
}

<h1>Kitap Ödünç Ver</h1>
<hr />

<div style="max-width: 600px;">
    <form id="oduncForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Kitap Arama -->
        <div class="mb-3">
            <label for="kitapArama">Kitap Ara</label>
            <input type="text" id="kitapArama" class="form-control" placeholder="Kitap adı yazın..." autocomplete="off" />
            <div id="kitapSonuclari" class="list-group" style="display:none; margin-top:6px;"></div>
            <div id="seciliKitap" class="alert alert-success mt-2" style="display:none;">
                <strong>Seçili Kitap:</strong> <span id="seciliKitapAdi"></span>
                <input type="hidden" asp-for="KitapId" id="kitapId" />
            </div>
        </div>

        <!-- Öğrenci Arama -->
        <div class="mb-3">
            <label for="ogrenciArama">Öğrenci Ara</label>
            <input type="text" id="ogrenciArama" class="form-control" placeholder="Öğrenci adı veya soyadı yazın..." autocomplete="off" />
            <div id="ogrenciSonuclari" class="list-group" style="display:none; margin-top:6px;"></div>
            <div id="seciliOgrenci" class="alert alert-success mt-2" style="display:none;">
                <strong>Seçili Öğrenci:</strong> <span id="seciliOgrenciAdi"></span>
                <input type="hidden" asp-for="OgrenciId" id="ogrenciId" />
            </div>
        </div>

        <div class="mt-4">
            <button type="button" class="btn btn-primary" id="tamamlaBtn" disabled>
                <i class="fas fa-check me-2"></i>Tamamla
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            // Kitap arama
            $('#kitapArama').on('input', function () {
                var arama = $(this).val().trim();
                if (arama.length >= 2) {
                    $.get('/Odunc/KitapAra', { arama: arama }, function (kitaplar) {
                        var sonuclar = $('#kitapSonuclari');
                        sonuclar.empty().show();
                        if (kitaplar && kitaplar.length > 0) {
                            kitaplar.forEach(function (kitap) {
                                var disabled = kitap.oduncDurumu ? 'disabled' : '';
                                sonuclar.append(`
                                    <div class="list-group-item list-group-item-action ${disabled}" 
                                         data-id="${kitap.id}" 
                                         data-ad="${kitap.kitapAdi}">
                                        ${kitap.kitapAdi} 
                                        ${kitap.oduncDurumu ? '<span class="badge bg-danger float-end">Ödünç Verildi</span>' : ''}
                                    </div>
                                `);
                            });
                        } else {
                            sonuclar.append('<div class="list-group-item">Sonuç bulunamadı.</div>');
                        }
                    });
                } else {
                    $('#kitapSonuclari').hide();
                }
            });

            // Öğrenci arama
            $('#ogrenciArama').on('input', function () {
                var arama = $(this).val().trim();
                if (arama.length >= 2) {
                    $.get('/Odunc/OgrenciAra', { arama: arama }, function (ogrenciler) {
                        var sonuclar = $('#ogrenciSonuclari');
                        sonuclar.empty().show();
                        if (ogrenciler && ogrenciler.length > 0) {
                            ogrenciler.forEach(function (ogrenci) {
                                sonuclar.append(`
                                    <div class="list-group-item list-group-item-action" 
                                         data-id="${ogrenci.id}" 
                                         data-ad="${ogrenci.adSoyad}">
                                        ${ogrenci.adSoyad}
                                    </div>
                                `);
                            });
                        } else {
                            sonuclar.append('<div class="list-group-item">Sonuç bulunamadı.</div>');
                        }
                    });
                } else {
                    $('#ogrenciSonuclari').hide();
                }
            });

            // Kitap seçimi
            $('#kitapSonuclari').on('click', '.list-group-item:not(.disabled)', function () {
                var id = $(this).data('id');
                var ad = $(this).data('ad');
                $('#kitapId').val(id);
                $('#seciliKitapAdi').text(ad);
                $('#seciliKitap').show();
                $('#kitapSonuclari').hide();
                $('#kitapArama').val('');
                kontrolEt();
            });

            // Öğrenci seçimi
            $('#ogrenciSonuclari').on('click', '.list-group-item', function () {
                var id = $(this).data('id');
                var ad = $(this).data('ad');
                $('#ogrenciId').val(id);
                $('#seciliOgrenciAdi').text(ad);
                $('#seciliOgrenci').show();
                $('#ogrenciSonuclari').hide();
                $('#ogrenciArama').val('');
                kontrolEt();
            });

            // Form kontrolü
            function kontrolEt() {
                const kitapSecildi = $('#kitapId').val() !== '';
                const ogrenciSecildi = $('#ogrenciId').val() !== '';
                $('#tamamlaBtn').prop('disabled', !(kitapSecildi && ogrenciSecildi));
            }

            // Form gönderimi
            $('#tamamlaBtn').click(function () {
                const formData = {
                    KitapId: $('#kitapId').val(),
                    OgrenciId: $('#ogrenciId').val()
                };

                $.ajax({
                    url: '/Odunc/Ver',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            alert('Kitap başarıyla ödünç verildi.');
                            window.location.href = '/Odunc';
                        } else {
                            alert('Bir hata oluştu: ' + response.message);
                        }
                    },
                    error: function () {
                        alert('Bir hata oluştu. Lütfen tekrar deneyin.');
                    }
                });
            });

            // Dışarı tıklandığında sonuçları gizle
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#kitapArama, #kitapSonuclari').length) {
                    $('#kitapSonuclari').hide();
                }
                if (!$(e.target).closest('#ogrenciArama, #ogrenciSonuclari').length) {
                    $('#ogrenciSonuclari').hide();
                }
            });
        });
    </script>
}
