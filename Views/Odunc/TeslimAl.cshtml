@model Kutuphane.Models.OduncKitap

@{
    ViewData["Title"] = "Teslim Al";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #12121e;
        color: #ddd;
        padding: 40px;
        cursor: none;
        min-height: 100vh;
        display: flex;
        justify-content: center;
    }

    div.container {
        max-width: 500px;
        width: 100%;
        background-color: #1f2233;
        border-radius: 12px;
        padding: 30px 40px;
        box-shadow: 0 0 25px rgba(0, 188, 212, 0.25);
    }

    h2 {
        color: #00bcd4;
        font-weight: 600;
        font-size: 1.9rem;
        margin-bottom: 30px;
        text-align: center;
        text-shadow: 0 0 8px #00bcd4aa;
    }

    h4 {
        color: #fff;
        font-size: 1.25rem;
        margin-bottom: 18px;
        font-weight: 600;
    }

    hr {
        border-color: #00bcd4;
        margin-bottom: 25px;
    }

    dl.row {
        margin-bottom: 30px;
    }

    dt.col-sm-3 {
        color: #00bcd4;
        font-weight: 600;
        margin-bottom: 6px;
        font-size: 1rem;
    }

    dd.col-sm-9 {
        color: #ccc;
        margin: 0 0 16px 0;
        font-size: 1rem;
    }

    .text-success {
        color: #4caf50;
        font-weight: 600;
    }

    .text-danger {
        color: #f44336;
        font-weight: 600;
    }

    .form-group p {
        font-size: 1.1rem;
        margin-bottom: 25px;
        color: #ddd;
        font-weight: 500;
        text-align: center;
    }

    .btn {
        display: inline-block;
        width: 48%;
        padding: 12px 0;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        border: none;
        transition: background-color 0.3s ease;
        user-select: none;
        text-align: center;
        text-decoration: none;
    }

    .btn-success {
        background-color: #4caf50;
        color: #121212;
    }

    .btn-success:hover {
        background-color: #43a047;
    }

    .btn-secondary {
        background-color: #555a6e;
        color: #eee;
    }

    .btn-secondary:hover {
        background-color: #777d91;
    }

    .btn + .btn {
        margin-left: 4%;
    }

    /* Minimal custom cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 20px; height: 20px;
        border: 2px solid #00bcd4;
        border-radius: 50%;
        pointer-events: none;
        transform: translate(-50%, -50%);
        z-index: 9999;
        mix-blend-mode: difference;
        transition: transform 0.15s ease, background-color 0.3s ease;
        background-color: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.4);
        background-color: #00bcd4;
        border-color: #ffffffcc;
    }
</style>

<div class="container">
    <h2>📘 Kitap Teslim Onayı</h2>

    <h4>📄 Ödünç Kitap Bilgileri</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Kitap Adı</dt>
        <dd class="col-sm-9">@Model.Kitap?.KitapAdi</dd>

        <dt class="col-sm-3">Öğrenci</dt>
        <dd class="col-sm-9">@Model.Ogrenci?.OgrenciAdi @Model.Ogrenci?.OgrenciSoyadi</dd>

        <dt class="col-sm-3">Ödünç Alınma Tarihi</dt>
        <dd class="col-sm-9">@Model.OduncAlmaTarihi.ToString("dd.MM.yyyy")</dd>

        <dt class="col-sm-3">Teslim Tarihi</dt>
        <dd class="col-sm-9">
            @(Model.TeslimTarihi.HasValue ? Model.TeslimTarihi.Value.ToString("dd.MM.yyyy HH:mm") : "Henüz teslim edilmedi")
        </dd>

        <dt class="col-sm-3">Teslim Durumu</dt>
        <dd class="col-sm-9">
            @if (Model.TeslimDurumu)
            {
                <span class="text-success">Teslim Edildi</span>
            }
            else
            {
                <span class="text-danger">Teslim Edilmedi</span>
            }
        </dd>
    </dl>

    <form asp-action="TeslimAl" method="post" style="text-align:center;">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <p>Bu kitabı <strong>teslim almak</strong> istiyor musunuz?</p>
            <button type="submit" class="btn btn-success">✅ Evet, Teslim Al</button>
            <a asp-action="Index" class="btn btn-secondary">❌ İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Custom Cursor
        const cursor = document.createElement('div');
        cursor.classList.add('custom-cursor');
        document.body.appendChild(cursor);

        document.addEventListener('mousemove', e => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });

        document.querySelectorAll('button, a').forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
    </script>
}
