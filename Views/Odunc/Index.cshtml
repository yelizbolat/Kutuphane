@model List<Kutuphane.Models.OduncKitap>

@{
    ViewData["Title"] = "Ödünç Kitap Listesi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-book-reader me-2 text-primary"></i>@ViewData["Title"]
        </h1>
        <a href="/Odunc/Ver" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Yeni Ödünç Ver
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Kitap</th>
                            <th>Öğrenci</th>
                            <th>Alınma Tarihi</th>
                            <th>Teslim Tarihi</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var odunc in Model)
                        {
                            <tr>
                                <td>@odunc.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-info text-white me-2">
                                            <i class="fas fa-book"></i>
                                        </div>
                                        <div>
                                            <div class="fw-medium">@odunc.Kitap.KitapAdi</div>
                                            <small class="text-muted">@odunc.Kitap.Yazar</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white me-2">
                                            @odunc.Ogrenci.OgrenciAdi[0]@odunc.Ogrenci.OgrenciSoyadi[0]
                                        </div>
                                        <div>
                                            <div class="fw-medium">@odunc.Ogrenci.OgrenciAdi @odunc.Ogrenci.OgrenciSoyadi</div>
                                            <small class="text-muted">@odunc.Ogrenci.OkulNumarasi</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@odunc.OduncAlmaTarihi.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (odunc.TeslimTarihi.HasValue)
                                    {
                                        <span>@odunc.TeslimTarihi.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (odunc.TeslimTarihi.HasValue)
                                    {
                                        <span class="badge bg-success">Teslim Edildi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Ödünç Verildi</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!odunc.TeslimTarihi.HasValue)
                                    {
                                        <a href="/Odunc/TeslimAl/@odunc.Id" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-check"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        font-weight: 500;
    }
</style>

@section Scripts {
    <script>
        // Enable tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}
