@{
    ViewData["Title"] = "Kitap Ara";
}

<h2>🔍 Kitap Arama</h2>

<div class="form-group">
    <label for="arama">Kitap Adı:</label>
    <input type="text" id="arama" placeholder="Kitap adı giriniz..." autocomplete="off" />
</div>

<table id="sonuclar">
    <thead>
        <tr>
            <th>Kitap Adı</th>
            <th>Ödünç Durumu</th>
        </tr>
    </thead>
    <tbody>
        <!-- Sonuçlar buraya gelecek -->
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(function () {
            $('#arama').on('keyup', function () {
                const arama = $(this).val().trim();

                if (arama.length < 2) {
                    $('#sonuclar tbody').empty();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("KitapAra", "Odunc")',
                    type: 'GET',
                    data: { arama: arama },
                    success: function (data) {
                        const tbody = $('#sonuclar tbody');
                        tbody.empty();

                        if (!data || data.length === 0) {
                            tbody.append('<tr><td colspan="2">Sonuç bulunamadı.</td></tr>');
                        } else {
                            data.forEach(kitap => {
                                const durum = kitap.oduncDurumu
                                    ? '<span class="text-danger">Ödünçte</span>'
                                    : '<span class="text-success">Müsait</span>';
                                tbody.append(`<tr><td>${kitap.kitapAdi}</td><td>${durum}</td></tr>`);
                            });
                        }
                    },
                    error: function () {
                        alert("Bir hata oluştu.");
                    }
                });
            });

            // Custom cursor
            const cursor = document.createElement('div');
            cursor.classList.add('custom-cursor');
            document.body.appendChild(cursor);

            document.addEventListener('mousemove', e => {
                cursor.style.left = e.clientX + 'px';
                cursor.style.top = e.clientY + 'px';
            });

            $('input, button, table, a').hover(
                () => cursor.classList.add('hover'),
                () => cursor.classList.remove('hover')
            );
        });
    </script>
}
