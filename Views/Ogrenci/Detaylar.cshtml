@model Kutuphane.Models.ViewModels.OgrenciDetayViewModel

@{
    ViewData["Title"] = "Öğrenci Detayları";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-graduate me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <div class="avatar-circle bg-primary text-white me-3">
                            @Model.OgrenciAdi[0]@Model.OgrenciSoyadi[0]
                        </div>
                        <div>
                            <h4 class="mb-0">@Model.OgrenciAdi @Model.OgrenciSoyadi</h4>
                            <small class="text-muted">Okul No: @Model.OkulNumarasi</small>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fas fa-info-circle me-2"></i>Öğrenci Bilgileri
                                    </h5>
                                    <div class="mt-3">
                                        <div class="mb-2">
                                            <strong>Ad Soyad:</strong>
                                            <span class="ms-2">@Model.OgrenciAdi @Model.OgrenciSoyadi</span>
                                        </div>
                                        <div class="mb-2">
                                            <strong>Okul Numarası:</strong>
                                            <span class="ms-2">@Model.OkulNumarasi</span>
                                        </div>
                                        <div>
                                            <strong>Sınıf:</strong>
                                            <span class="ms-2">@Model.SinifAdi</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ödünç Alınan Kitaplar -->
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <i class="fas fa-book me-2"></i>Ödünç Alınan Kitaplar
                            </h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Kitap</th>
                                            <th>Yazar</th>
                                            <th>Alınma Tarihi</th>
                                            <th>Teslim Tarihi</th>
                                            <th>Durum</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.OduncKitaplar.Any())
                                        {
                                            foreach (var kitap in Model.OduncKitaplar)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="avatar-circle bg-info text-white me-2">
                                                                <i class="fas fa-book"></i>
                                                            </div>
                                                            <div class="fw-medium">@kitap.KitapAdi</div>
                                                        </div>
                                                    </td>
                                                    <td>@kitap.Yazar</td>
                                                    <td>@kitap.AlinmaTarihi.ToString("dd.MM.yyyy")</td>
                                                    <td>
                                                        @if (kitap.TeslimTarihi.HasValue)
                                                        {
                                                            <span>@kitap.TeslimTarihi.Value.ToString("dd.MM.yyyy")</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (kitap.TeslimDurumu)
                                                        {
                                                            <span class="badge bg-success">Teslim Edildi</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning">Ödünç Verildi</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4">
                                                    <div class="text-muted">
                                                        <i class="fas fa-info-circle me-2"></i>
                                                        Bu öğrencinin ödünç aldığı kitap bulunmamaktadır.
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-controller="Ogrenci" asp-action="Guncelle" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="fas fa-edit me-2"></i>Düzenle
                        </a>
                        <a asp-controller="Ogrenci" asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
</style> 