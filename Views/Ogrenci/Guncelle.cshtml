@model Ogrenci

@{
    ViewData["Title"] = "Öğrenci Güncelle";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #f5f7fa;
        color: #333;
        margin: 40px;
        cursor: none;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
    }

    h2 {
        color: #2563eb;
        font-weight: 600;
        text-align: center;
        margin-bottom: 36px;
        user-select: none;
        letter-spacing: 0.03em;
        text-shadow: 0 0 6px #93c5fd88;
        width: 100%;
        max-width: 500px;
    }

    form {
        max-width: 500px;
        width: 100%;
        background: #ffffff;
        padding: 40px 45px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(37, 99, 235, 0.15);
        transition: box-shadow 0.3s ease;
    }

    form:hover {
        box-shadow: 0 6px 28px rgba(37, 99, 235, 0.3);
    }

    .form-group {
        margin-bottom: 24px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #2563eb;
        font-size: 1.1rem;
    }

    input[type="text"],
    select {
        width: 100%;
        padding: 14px 16px;
        font-size: 1rem;
        border: 2px solid #d1d5db;
        border-radius: 10px;
        background: #fafafa;
        color: #333;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
        box-sizing: border-box;
    }

    input[type="text"]:focus,
    select:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 8px #2563ebaa;
        background: #ffffff;
    }

    .text-danger {
        color: #ef4444;
        font-size: 0.9rem;
        margin-top: 6px;
        display: block;
        user-select: none;
    }

    button.btn-primary {
        width: 100%;
        background: linear-gradient(45deg, #2563eb, #1e40af);
        box-shadow: 0 5px 18px rgba(37, 99, 235, 0.6);
        border: none;
        padding: 16px 0;
        border-radius: 40px;
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        cursor: pointer;
        transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
        user-select: none;
    }

    button.btn-primary:hover {
        background: linear-gradient(45deg, #1e40af, #2563eb);
        box-shadow: 0 8px 28px rgba(37, 99, 235, 0.8);
        transform: translateY(-4px);
    }

    /* Özel Cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 30px;
        height: 30px;
        border: 2.5px solid #2563eb;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.5);
        background-color: #2563eb;
        border-color: white;
    }
</style>

<h2>@ViewData["Title"]</h2>

<form asp-action="Guncelle" method="post" novalidate>
    <div class="form-group">
        <label asp-for="OgrenciAdi"></label>
        <input asp-for="OgrenciAdi" />
        <span asp-validation-for="OgrenciAdi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OgrenciSoyadi"></label>
        <input asp-for="OgrenciSoyadi" />
        <span asp-validation-for="OgrenciSoyadi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="OkulNumarasi"></label>
        <input asp-for="OkulNumarasi" />
        <span asp-validation-for="OkulNumarasi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="SinifId"></label>
        <select asp-for="SinifId" asp-items="@(ViewBag.Siniflar)">
            <option value="0">Bir Sınıf Seç</option>
        </select>
        <span asp-validation-for="SinifId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Güncelle</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('button, select, input').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
