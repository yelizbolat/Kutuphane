@model Ogrenci

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet" />

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f9fafb;
        color: #333;
        padding: 40px;
        cursor: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        margin: 0;
    }

    h2 {
        color: #2563eb;
        font-weight: 700;
        text-align: center;
        margin-bottom: 25px;
        letter-spacing: 0.05em;
        user-select: none;
        text-shadow: 0 0 6px #93c5fd88;
    }

    p {
        font-size: 1.15rem;
        text-align: center;
        margin-bottom: 40px;
        color: #4b5563;
        max-width: 420px;
        line-height: 1.5;
    }

    form {
        display: flex;
        justify-content: center;
        gap: 20px;
        flex-wrap: wrap;
        max-width: 420px;
        width: 100%;
    }

    button.btn-danger {
        background-color: #ef4444;
        border: none;
        color: white;
        padding: 12px 32px;
        font-weight: 600;
        border-radius: 30px;
        box-shadow: 0 6px 18px rgba(239, 68, 68, 0.4);
        transition: background-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
        cursor: pointer;
        user-select: none;
        flex: 1 1 150px;
        text-align: center;
    }

    button.btn-danger:hover {
        background-color: #b91c1c;
        box-shadow: 0 10px 30px rgba(185, 28, 28, 0.6);
        transform: translateY(-3px);
    }

    a.btn-secondary {
        background-color: #e5e7eb;
        color: #374151;
        padding: 12px 32px;
        font-weight: 600;
        border-radius: 30px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(107, 114, 128, 0.3);
        transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
        user-select: none;
        flex: 1 1 150px;
        text-align: center;
    }

    a.btn-secondary:hover {
        background-color: #d1d5db;
        color: #111827;
        transform: translateY(-3px);
    }

    /* Özel cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 30px;
        height: 30px;
        border: 2.5px solid #2563eb;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.5);
        background-color: #2563eb;
        border-color: white;
    }
</style>

<h2>Öğrenci Sil</h2>
<p>@Model.OgrenciAdi @Model.OgrenciSoyadi adlı öğrenciyi silmek istediğinize emin misiniz?</p>

<form asp-action="SilOnayla" method="post" asp-controller="Ogrenci">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('button.btn-danger, a.btn-secondary').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
