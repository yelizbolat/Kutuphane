@model Kutuphane.Models.Ogrenci

@{
    ViewData["Title"] = "Öğrenci Sil";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="fas fa-user-minus me-2"></i>Öğrenci Sil</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Dikkat!</strong> Bu işlem geri alınamaz.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-3">Ad Soyad</dt>
                        <dd class="col-sm-9">@Model.OgrenciAdi @Model.OgrenciSoyadi</dd>

                        <dt class="col-sm-3">Okul Numarası</dt>
                        <dd class="col-sm-9">@Model.OkulNumarasi</dd>

                        <dt class="col-sm-3">Sınıf</dt>
                        <dd class="col-sm-9">@(Model.Sinif?.SinifAdi ?? "Belirtilmemiş")</dd>
                    </dl>

                    @if (ViewBag.OduncKitaplar != null && ViewBag.OduncKitaplar.Count > 0)
                    {
                        <div class="alert alert-danger mt-3">
                            <h5><i class="fas fa-exclamation-circle me-2"></i>Ödünç Alınmış Kitaplar</h5>
                            <p>Bu öğrencinin teslim etmediği kitaplar var. Önce kitapları teslim almalısınız.</p>
                            <ul class="list-group mt-2">
                                @foreach (var kitap in ViewBag.OduncKitaplar)
                                {
                                    <li class="list-group-item list-group-item-danger">
                                        <i class="fas fa-book me-2"></i>@kitap.Kitap.KitapAdi
                                        <small class="text-muted ms-2">(Alınma: @kitap.OduncAlmaTarihi.ToString("dd.MM.yyyy"))</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Sil" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            @if (ViewBag.OduncKitaplar == null || ViewBag.OduncKitaplar.Count == 0)
                            {
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash-alt me-2"></i>Sil
                                </button>
                            }
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const cursor = document.createElement('div');
        cursor.classList.add('custom-cursor');
        document.body.appendChild(cursor);

        document.addEventListener('mousemove', e => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });

        document.querySelectorAll('button, a.btn').forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
    </script>
}
