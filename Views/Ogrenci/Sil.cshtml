@model Kutuphane.Models.Ogrenci

@{
    ViewData["Title"] = "Öğrenci Sil";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-user-times me-2"></i>@ViewData["Title"]
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Dikkat!</strong> Bu öğrenciyi silmek istediğinizden emin misiniz?
                    </div>

                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar-circle bg-primary text-white me-3">
                                @Model.OgrenciAdi[0]@Model.OgrenciSoyadi[0]
                            </div>
                            <div>
                                <h5 class="mb-0">@Model.OgrenciAdi @Model.OgrenciSoyadi</h5>
                                <small class="text-muted">@Model.OkulNumarasi</small>
                            </div>
                        </div>
                        <div class="mb-2">
                            <strong>Sınıf:</strong>
                            <span class="badge bg-info">@Model.Sinif?.SinifAdi</span>
                        </div>
                    </div>

                    @if (ViewBag.OduncKitaplar != null && ViewBag.OduncKitaplar.Count > 0)
                    {
                        <div class="alert alert-danger">
                            <h5 class="alert-heading">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                Ödünç Alınmış Kitaplar
                            </h5>
                            <p class="mb-2">Bu öğrencinin teslim etmediği kitaplar var. Önce kitapları teslim almalısınız.</p>
                            <div class="list-group mt-3">
                                @foreach (var kitap in ViewBag.OduncKitaplar)
                                {
                                    <div class="list-group-item list-group-item-danger d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="fas fa-book me-2"></i>
                                            @kitap.Kitap.KitapAdi
                                        </div>
                                        <small class="text-muted">
                                            Alınma: @kitap.OduncAlmaTarihi.ToString("dd.MM.yyyy")
                                        </small>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <form asp-action="Sil" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            @if (ViewBag.OduncKitaplar == null || ViewBag.OduncKitaplar.Count == 0)
                            {
                                <button type="submit" class="btn btn-danger">
                                    <i class="fas fa-trash me-2"></i>Sil
                                </button>
                            }
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left me-2"></i>İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        font-weight: 500;
    }
</style>

@section Scripts {
    <script>
        const cursor = document.createElement('div');
        cursor.classList.add('custom-cursor');
        document.body.appendChild(cursor);

        document.addEventListener('mousemove', e => {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
        });

        document.querySelectorAll('button, a.btn').forEach(el => {
            el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
        });
    </script>
}
