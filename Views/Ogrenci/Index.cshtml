@model List<Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Listesi";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #121212;
        color: #eee;
        margin: 40px;
        cursor: none;
    }

    h1 {
        color: #ff4081;
        font-weight: 700;
        text-align: center;
        margin-bottom: 40px;
        text-shadow: 0 0 10px #ff4081;
    }

    table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
        background: #1f1f1f;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(255, 64, 129, 0.3);
    }

    thead tr {
        background: #ff4081;
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        text-align: left;
        box-shadow: 0 3px 10px rgba(255, 64, 129, 0.7);
    }

    thead th {
        padding: 16px 24px;
        user-select: none;
    }

    tbody tr {
        background: #222;
        transition: background 0.3s ease;
        cursor: pointer;
        border-radius: 10px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.5);
    }

    tbody tr:hover {
        background: #2a2a2a;
        box-shadow: 0 6px 20px rgba(255, 64, 129, 0.6);
    }

    tbody td {
        padding: 16px 24px;
        vertical-align: middle;
    }

    /* Butonlar */
    a.btn {
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 12px;
        transition: background 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        display: inline-block;
        user-select: none;
    }

    a.btn-warning {
        background: #ff80ab;
        color: #3a3a3a;
        box-shadow: 0 4px 12px rgba(255, 128, 171, 0.5);
    }

    a.btn-warning:hover {
        background: #f50057;
        color: white;
        box-shadow: 0 8px 25px rgba(245, 0, 87, 0.8);
    }

    a.btn-danger {
        background: #ff1744;
        color: white;
        box-shadow: 0 4px 12px rgba(255, 23, 68, 0.5);
    }

    a.btn-danger:hover {
        background: #d50000;
        box-shadow: 0 8px 25px rgba(213, 0, 0, 0.8);
    }

    a.btn-primary {
        background: linear-gradient(45deg, #ff4081, #f50057);
        color: white;
        font-weight: 700;
        padding: 14px 30px;
        border-radius: 40px;
        box-shadow: 0 6px 20px rgba(245, 0, 87, 0.7);
        margin-top: 25px;
        display: inline-block;
        user-select: none;
        transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }

    a.btn-primary:hover {
        background: linear-gradient(45deg, #f50057, #ff4081);
        box-shadow: 0 10px 35px rgba(245, 0, 87, 0.9);
        transform: translateY(-3px);
    }

    /* Özel Cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 40px;
        height: 40px;
        border: 3px solid #ff4081;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.5);
        background-color: #ff4081;
        border-color: white;
    }
</style>

<h1>@ViewData["Title"]</h1>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Adı</th>
            <th>Soyadı</th>
            <th>Okul Numarası</th>
            <th>Sınıf</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ogrenci in Model)
        {
            <tr>
                <td>@ogrenci.Id</td>
                <td>@ogrenci.OgrenciAdi</td>
                <td>@ogrenci.OgrenciSoyadi</td>
                <td>@ogrenci.OkulNumarasi</td>
                <td>@ogrenci.Sinif?.SinifAdi</td>
                <td>
                    <a href="/Ogrenci/Guncelle/@ogrenci.Id" class="btn btn-warning btn-sm">Güncelle</a>
                    <a href="/Ogrenci/Sil/@ogrenci.Id" class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div style="text-align:center;">
    <a href="/Ogrenci/Ekle" class="btn btn-primary">Yeni Öğrenci Ekle</a>
</div>

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('a.btn').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
