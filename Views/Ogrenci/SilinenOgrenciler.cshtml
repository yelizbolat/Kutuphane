@model List<Kutuphane.Models.SilinenOgrenci>

@{
    ViewData["Title"] = "Silinen Öğrenciler";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-user-slash me-2 text-danger"></i>@ViewData["Title"]
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Öğrenci Listesine Dön
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    Henüz silinmiş öğrenci bulunmamaktadır.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Okul Numarası</th>
                                <th>Sınıf</th>
                                <th>Silinme Tarihi</th>
                                <th>Silen Kullanıcı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ogrenci in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-danger text-white me-2">
                                                @ogrenci.OgrenciAdi[0]@ogrenci.OgrenciSoyadi[0]
                                            </div>
                                            <div>
                                                @ogrenci.OgrenciAdi @ogrenci.OgrenciSoyadi
                                            </div>
                                        </div>
                                    </td>
                                    <td>@ogrenci.OkulNumarasi</td>
                                    <td>
                                        <span class="badge bg-secondary">@ogrenci.SinifAdi</span>
                                    </td>
                                    <td>@ogrenci.SilinmeTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@ogrenci.SilenKullanici</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        font-weight: 500;
    }
</style> 