@model IEnumerable<Kutuphane.Models.KitapOduncIslemleri>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Zamanında Teslim Edilmeyen Kitaplar</h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Öğrenci Adı</th>
                                    <th>Kitap Adı</th>
                                    <th>Alınma Tarihi</th>
                                    <th>Teslim Tarihi</th>
                                    <th>Gerçek Teslim Tarihi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.OgrenciAdi</td>
                                            <td>@item.KitapAdi</td>
                                            <td>@item.AlinmaTarihi.ToString("dd/MM/yyyy")</td>
                                            <td>@item.TeslimTarihi.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (item.GercekTeslimTarihi != null)
                                                {
                                                    <span class="badge bg-success">@item.GercekTeslimTarihi?.ToString("dd/MM/yyyy")</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Teslim Edilmedi</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center">Tüm kitaplar zamanında teslim edilmiş görünüyor.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
