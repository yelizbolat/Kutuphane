@model IEnumerable<Kutuphane.Models.KitapOduncIslemleri>

<style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f9fafb;
        color: #333;
    }

    h2 {
        color: #2c3e50;
        font-weight: 600;
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
        border-left: 5px solid #3498db;
        padding-left: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    thead {
        background-color: #f1f5f9;
        font-weight: 600;
        font-size: 1rem;
    }

    th, td {
        padding: 14px 20px;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
        font-size: 0.95rem;
    }

    tbody tr:hover {
        background-color: #f8fafc;
    }

    .text-danger {
        color: #e74c3c;
        font-weight: 500;
    }

    .container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 30px 20px;
    }
</style>

<div class="container">
    <h2>Zamanında Teslim Edilmeyen Kitaplar</h2>

    <table>
        <thead>
            <tr>
                <th>Öğrenci Adı</th>
                <th>Kitap Adı</th>
                <th>Alınma Tarihi</th>
                <th>Teslim Tarihi</th>
                <th>Gerçek Teslim Tarihi</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.OgrenciAdi</td>
                    <td>@item.KitapAdi</td>
                    <td>@item.AlinmaTarihi.ToString("dd/MM/yyyy")</td>
                    <td>@item.TeslimTarihi.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.GercekTeslimTarihi.HasValue)
                        {
                            @item.GercekTeslimTarihi.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-danger">Teslim Edilmedi</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
