@model IEnumerable<Kutuphane.Models.KitapOduncIslemleri>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="alert alert-info mb-4">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Bilgi:</strong> Kitaplar ödünç alındıktan sonra 1 gün içinde teslim edilmelidir.
            </div>
            
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Süresi Geçen Kitaplar (1 Günden Fazla)
                    </h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Öğrenci Adı</th>
                                    <th>Kitap Adı</th>
                                    <th>Alınma Tarihi</th>
                                    <th>Son Teslim Tarihi</th>
                                    <th>Gecikme Süresi</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        var gecikmeGun = (DateTime.Now - item.TeslimTarihi).Days;
                                        <tr>
                                            <td>@item.OgrenciAdi</td>
                                            <td>@item.KitapAdi</td>
                                            <td>@item.AlinmaTarihi.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@item.TeslimTarihi.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>
                                                <span class="badge bg-danger">@gecikmeGun gün gecikme</span>
                                            </td>
                                            <td>
                                                @if (item.GercekTeslimTarihi != null)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="fas fa-check-circle me-1"></i>
                                                        Teslim Edildi: @item.GercekTeslimTarihi?.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="fas fa-exclamation-circle me-1"></i>
                                                        Teslim Edilmedi
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4">
                                            <div class="text-success">
                                                <i class="fas fa-check-circle me-2"></i>
                                                Tüm kitaplar zamanında teslim edilmiş görünüyor.
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>