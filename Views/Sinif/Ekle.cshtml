@model Sinif

@{
    ViewData["Title"] = "Sınıf Ekle";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #20232a;
        color: #e0e0e0;
        margin: 40px;
        cursor: none;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
    }

    h2 {
        color: #61dafb;
        font-weight: 600;
        text-align: center;
        margin-bottom: 24px;
        user-select: none;
        letter-spacing: 0.04em;
    }

    form {
        background: #2c2f3a;
        padding: 24px 32px;
        border-radius: 10px;
        width: 340px;
        box-shadow: 0 4px 12px rgba(97, 218, 251, 0.25);
        display: flex;
        flex-direction: column;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #61dafb;
        font-size: 1rem;
        user-select: none;
    }

    input[type="text"] {
        width: 100%;
        padding: 10px 14px;
        font-size: 1rem;
        border: 1.5px solid #444c56;
        border-radius: 6px;
        background: #1f222a;
        color: #ddd;
        transition: border-color 0.25s ease, background 0.25s ease;
        user-select: text;
    }

    input[type="text"]:focus {
        outline: none;
        border-color: #61dafb;
        background: #283044;
        box-shadow: 0 0 6px #61dafb66;
    }

    .text-danger {
        color: #ff6b6b;
        font-size: 0.85rem;
        margin-top: 4px;
        min-height: 18px;
    }

    button.btn-primary {
        background-color: #61dafb;
        border: none;
        padding: 12px 0;
        border-radius: 28px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1b1f27;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
        user-select: none;
    }

    button.btn-primary:hover {
        background-color: #21a1f1;
        transform: translateY(-3px);
    }

    /* Custom cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 28px;
        height: 28px;
        border: 2.5px solid #61dafb;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.4);
        background-color: #61dafb;
        border-color: white;
    }
</style>

<div>
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Ekle" method="post" novalidate>
        <div class="form-group">
            <label asp-for="SinifAdi"></label>
            <input asp-for="SinifAdi" />
            <span asp-validation-for="SinifAdi" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('button').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
