@model IEnumerable<Kutuphane.Models.ViewModels.SinifViewModel>

@{
    ViewData["Title"] = "Sınıf Listesi";
}

<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">
            <i class="fas fa-school me-2 text-primary"></i>@ViewData["Title"]
        </h1>
        <a asp-action="Ekle" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Yeni Sınıf Ekle
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Sınıf Adı</th>
                            <th>Öğrenci Sayısı</th>
                            <th>Doluluk Oranı</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sinif in Model)
                        {
                            <tr>
                                <td>@sinif.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle bg-primary text-white me-2">
                                            <i class="fas fa-users"></i>
                                        </div>
                                        <div class="fw-medium">@sinif.SinifAdi</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@sinif.OgrenciSayisi öğrenci</span>
                                </td>
                                <td>
                                    @{
                                        var dolulukOrani = sinif.OgrenciSayisi * 100 / 40; // Varsayılan maksimum 40 öğrenci
                                        var progressClass = dolulukOrani switch
                                        {
                                            <= 25 => "bg-success",
                                            <= 50 => "bg-info",
                                            <= 75 => "bg-warning",
                                            _ => "bg-danger"
                                        };
                                    }
                                    <div class="progress" style="height: 8px; width: 100px;">
                                        <div class="progress-bar @progressClass" role="progressbar" 
                                             style="width: @dolulukOrani%;" 
                                             aria-valuenow="@dolulukOrani" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Guncelle" asp-route-id="@sinif.Id" 
                                           class="btn btn-sm btn-outline-primary" 
                                           data-bs-toggle="tooltip" 
                                           title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Detaylar" asp-route-id="@sinif.Id" 
                                           class="btn btn-sm btn-outline-info" 
                                           data-bs-toggle="tooltip" 
                                           title="Detaylar">
                                            <i class="fas fa-info-circle"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="tooltip" 
                                                title="Sil"
                                                onclick="confirmDelete(@sinif.Id)">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }
</style>

@section Scripts {
    <script>
        // Enable tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })

        // Delete confirmation
        function confirmDelete(id) {
            if (confirm('Bu sınıfı silmek istediğinizden emin misiniz?')) {
                window.location.href = '/Sinif/Sil/' + id;
            }
        }
    </script>
}
