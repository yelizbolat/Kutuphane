@model IEnumerable<Sinif>

@{
    ViewData["Title"] = "Sınıflar";
}

<!-- Google Fonts Modern Font -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #121212;
        color: #ddd;
        margin: 40px;
        cursor: none; /* Özel cursor için */
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
    }

    h1 {
        font-weight: 600;
        color: #60a5fa;
        margin-bottom: 28px;
        text-align: center;
        user-select: none;
        letter-spacing: 0.04em;
        text-shadow: 0 0 6px #60a5faaa;
    }

    table {
        width: 100%;
        max-width: 720px;
        border-collapse: separate;
        border-spacing: 0 14px;
        table-layout: fixed;
        border-radius: 12px;
        overflow: hidden;
    }

    thead th {
        background: #1e293b;
        padding: 14px 12px;
        text-align: left;
        font-weight: 600;
        font-size: 1rem;
        color: #60a5fa;
        user-select: none;
    }

    tbody tr {
        background: #273449;
        transition: background-color 0.25s ease;
        border-radius: 12px;
        box-shadow: inset 0 0 3px #0008;
    }

    tbody tr:hover {
        background: #60a5fa;
        color: #121212;
    }

    tbody td {
        padding: 14px 12px;
        font-size: 1rem;
        vertical-align: middle;
        overflow-wrap: break-word;
    }

    tbody td a {
        font-weight: 600;
        border-radius: 24px;
        padding: 8px 18px;
        margin-right: 8px;
        display: inline-block;
        text-decoration: none;
        color: #121212;
        background-color: #a5b4fc;
        box-shadow: 0 3px 8px #a5b4fcaa;
        transition: background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
        user-select: none;
    }

    tbody td a.btn-danger {
        background-color: #f87171;
        box-shadow: 0 3px 8px #f8717180;
        color: #121212;
    }

    tbody td a:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px;
    }

    tbody td a.btn-danger:hover {
        background-color: #ef4444;
        box-shadow: 0 6px 16px #ef444480;
        color: white;
    }

    a.btn-success {
        max-width: 720px;
        width: 100%;
        display: block;
        margin: 24px auto 0 auto;
        padding: 12px 0;
        font-size: 1.1rem;
        font-weight: 700;
        text-align: center;
        color: #121212;
        background-color: #86efac;
        border-radius: 30px;
        box-shadow: 0 5px 15px #86efacbb;
        text-decoration: none;
        user-select: none;
        transition: background-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    }

    a.btn-success:hover {
        background-color: #4ade80;
        box-shadow: 0 8px 25px #4ade8080;
        transform: translateY(-4px);
        color: #121212;
    }

    /* Özel Cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 32px;
        height: 32px;
        border: 2.5px solid #60a5fa;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.5);
        background-color: #60a5fa;
        border-color: white;
    }
</style>

<h1>@ViewData["Title"]</h1>

<table>
    <thead>
        <tr>
            <th style="width: 10%;">Id</th>
            <th style="width: 60%;">Sınıf Adı</th>
            <th style="width: 30%;">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var sinif in Model)
        {
            <tr>
                <td>@sinif.Id</td>
                <td>@sinif.SinifAdi</td>
                <td>
                    <a asp-action="Guncelle" asp-route-id="@sinif.Id" class="btn-primary">Düzenle</a>
                    <a asp-action="Sil" asp-route-id="@sinif.Id" class="btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Ekle" class="btn-success">Yeni Sınıf Ekle</a>

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('a').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
