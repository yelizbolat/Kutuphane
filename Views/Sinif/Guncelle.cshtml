@model Sinif

@{
    ViewData["Title"] = "Sınıf Güncelle";
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: #121212;
        color: #ddd;
        margin: 40px;
        cursor: none; /* Özel cursor */
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
    }

    h2 {
        color: #60a5fa;
        font-weight: 600;
        text-align: center;
        margin-bottom: 30px;
        user-select: none;
        letter-spacing: 0.03em;
    }

    form {
        max-width: 360px;
        width: 100%;
        background: #1e293b;
        padding: 28px 32px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(96, 165, 250, 0.3);
        display: flex;
        flex-direction: column;
    }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        font-weight: 600;
        margin-bottom: 6px;
        color: #60a5fa;
        font-size: 1rem;
        user-select: none;
    }

    input[type="text"] {
        width: 100%;
        padding: 10px 14px;
        font-size: 1rem;
        border: 1.5px solid #334155;
        border-radius: 8px;
        background: #273449;
        color: #e0e7ff;
        transition: border-color 0.25s ease, background 0.25s ease;
        user-select: text;
    }

    input[type="text"]:focus {
        outline: none;
        border-color: #60a5fa;
        background: #324454;
        box-shadow: 0 0 6px #60a5faaa;
    }

    .text-danger {
        color: #f87171;
        font-size: 0.85rem;
        margin-top: 4px;
        min-height: 18px;
    }

    button.btn-primary {
        background-color: #60a5fa;
        border: none;
        padding: 12px 0;
        border-radius: 30px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e293b;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.25s ease;
        user-select: none;
        margin-top: 10px;
    }

    button.btn-primary:hover {
        background-color: #3b82f6;
        transform: translateY(-3px);
    }

    a.btn-secondary {
        display: block;
        margin: 20px auto 0 auto;
        max-width: 360px;
        padding: 12px;
        background: transparent;
        color: #60a5fa;
        font-weight: 600;
        border-radius: 30px;
        text-align: center;
        text-decoration: none;
        border: 2px solid #60a5fa;
        transition: background-color 0.3s ease, color 0.3s ease;
        cursor: pointer;
        user-select: none;
    }

    a.btn-secondary:hover {
        background-color: #60a5fa;
        color: #1e293b;
    }

    /* Özel Cursor */
    .custom-cursor {
        position: fixed;
        top: 0; left: 0;
        width: 32px;
        height: 32px;
        border: 2.5px solid #60a5fa;
        border-radius: 50%;
        pointer-events: none;
        transition: transform 0.15s ease, background-color 0.3s ease;
        transform: translate(-50%, -50%);
        mix-blend-mode: difference;
        z-index: 9999;
        background: transparent;
    }

    .custom-cursor.hover {
        transform: translate(-50%, -50%) scale(1.4);
        background-color: #60a5fa;
        border-color: white;
    }
</style>

<div>
    <h2>@ViewData["Title"]</h2>

    <form asp-action="Guncelle" method="post" novalidate>
        <div class="form-group">
            <label asp-for="SinifAdi"></label>
            <input asp-for="SinifAdi" />
            <span asp-validation-for="SinifAdi" class="text-danger"></span>
        </div>
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-primary">Güncelle</button>
    </form>

    <a asp-action="Index" class="btn btn-secondary">Geri Dön</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    const cursor = document.createElement('div');
    cursor.classList.add('custom-cursor');
    document.body.appendChild(cursor);

    document.addEventListener('mousemove', e => {
        cursor.style.left = e.clientX + 'px';
        cursor.style.top = e.clientY + 'px';
    });

    document.querySelectorAll('button, a').forEach(el => {
        el.addEventListener('mouseenter', () => cursor.classList.add('hover'));
        el.addEventListener('mouseleave', () => cursor.classList.remove('hover'));
    });
</script>
