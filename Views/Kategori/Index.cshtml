@model IEnumerable<Kutuphane.Models.Kategori>
@{
    ViewData["Title"] = "Kategoriler";
    var pasifKategoriler = ViewBag.PasifKategoriler as List<Kutuphane.Models.Kategori>;
}

<h1 class="mb-4"><i class="fas fa-tags"></i> Kategoriler</h1>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <b>Aktif Kategoriler</b>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Adı</th>
                        <th>Açıklama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.KategoriAdi</td>
                            <td>@item.Aciklama</td>
                            <td>
                                <a asp-action="Guncelle" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Güncelle</a>
                                <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<a asp-action="Ekle" class="btn btn-primary mb-4"><i class="fas fa-plus"></i> Yeni Kategori</a>

@if (pasifKategoriler != null && pasifKategoriler.Count > 0)
{
    <div class="card mt-4 border-danger">
        <div class="card-header bg-danger text-white">
            <b>Silinen (Pasif) Kategoriler</b>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Adı</th>
                            <th>Açıklama</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pasifKategoriler)
                        {
                            <tr class="table-danger">
                                <td>@item.KategoriAdi</td>
                                <td>@item.Aciklama</td>
                                <td>
                                    <form asp-action="GeriAl" method="post" style="display:inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-undo"></i> Geri Al</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}