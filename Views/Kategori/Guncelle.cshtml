@model Kutuphane.Models.Kategori

@{
    ViewData["Title"] = "Kategori Güncelle";
}

<h1>Kategori Güncelle</h1>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Guncelle" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-4">
                <label asp-for="KategoriAdi"></label>
                <input asp-for="KategoriAdi" class="form-control" autocomplete="off" />
                <span asp-validation-for="KategoriAdi" class="text-danger"></span>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary">Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}