@model Kutuphane.Models.Kategori

@{
    ViewData["Title"] = "Kategori Sil";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />

<style>
    body {
        background-color: #f9fafb;
        color: #2c3e50;
        font-family: 'Inter', sans-serif;
    }

    h1 {
        font-size: 1.6rem;
        font-weight: 600;
        color: #e74c3c;
        margin-bottom: 1rem;
    }

    h3 {
        font-size: 1.1rem;
        color: #7f8c8d;
        margin-bottom: 1.5rem;
    }

    .form-wrapper {
        background-color: #fff;
        padding: 24px 28px;
        border-radius: 10px;
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        max-width: 600px;
        margin: 0 auto;
    }

    dl dt {
        font-weight: 600;
        margin-bottom: 4px;
    }

    dl dd {
        margin-bottom: 16px;
        color: #34495e;
    }

    .btn {
        padding: 10px 20px;
        font-size: 0.95rem;
        border-radius: 6px;
        font-weight: 500;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

    .btn-danger {
        background-color: #e74c3c;
        color: white;
    }

    .btn-danger:hover {
        background-color: #c0392b;
    }

    .btn-secondary {
        background-color: #bdc3c7;
        color: #2c3e50;
        margin-left: 10px;
    }

    .btn-secondary:hover {
        background-color: #95a5a6;
    }

    hr {
        border: 0;
        height: 1px;
        background-color: #eee;
        margin: 1.5rem 0;
    }
</style>

<h1>❌ Kategori Sil</h1>
<h3>Bu kategoriyi silmek istediğinizden emin misiniz?</h3>

<div class="form-wrapper">
    <hr />
    <dl class="row">
        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.KategoriAdi)</dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.KategoriAdi)</dd>
    </dl>

    <form asp-action="Sil" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </form>
</div>
